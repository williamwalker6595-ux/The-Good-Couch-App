# Server
PORT=3000
NODE_ENV=development

# Database
DATABASE_URL=postgres://postgres:postgres@localhost:5432/good_couch

# AI
ANTHROPIC_API_KEY=

# Quo (texting) — https://www.quo.com
QUO_API_KEY=
# Your Quo business number in E.164 format (e.g. +15555550123), used as the
# default "from" for outbound sends.
QUO_FROM_NUMBER=
# Base64-decoded signing key shown on the webhook's detail page in the Quo
# dashboard when you create it — used to verify the openphone-signature header.
QUO_WEBHOOK_SIGNING_KEY=
# Override only if Quo's API host differs from the default.
QUO_API_BASE_URL=https://api.quo.com

# Todoist (scheduling)
TODOIST_API_TOKEN=
