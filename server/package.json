{
  "name": "server",
  "private": true,
  "version": "0.1.0",
  "main": "dist/index.js",
  "engines": {
    "node": "20.x"
  },
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "migrate": "node-pg-migrate up -m dist/db/migrations",
    "migrate:down": "node-pg-migrate down -m dist/db/migrations",
    "migrate:create": "node-pg-migrate create -j ts --migration-file-language ts -m src/db/migrations",
    "history:stats": "node dist/scripts/quoHistoryStats.js"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.124.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "helmet": "^7.1.0",
    "pg": "^8.12.0",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^20.14.9",
    "@types/pg": "^8.11.6",
    "node-pg-migrate": "^7.6.1",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.5.3"
  }
}
