{
  "name": "the-good-couch-app",
  "private": true,
  "version": "0.1.0",
  "workspaces": [
    "server",
    "web"
  ],
  "engines": {
    "node": "20.x"
  },
  "scripts": {
    "dev": "npm run dev --workspace=server",
    "dev:web": "npm run dev --workspace=web",
    "build": "npm run build --workspace=server",
    "build:web": "npm run build --workspace=web",
    "start": "npm run start --workspace=server",
    "start:web": "npm run start --workspace=web",
    "migrate": "npm run migrate --workspace=server",
    "migrate:down": "npm run migrate:down --workspace=server",
    "history:stats": "npm run history:stats --workspace=server",
    "history:pull": "npm run history:pull --workspace=server",
    "history:summarize": "npm run history:summarize --workspace=server",
    "history:playbook": "npm run history:playbook --workspace=server"
  }
}
